@import "~/.config/rofi/style/colors.rasi"


* {
    /* base colors */
    background: @surface;
    background-alt: @surface-container;
    foreground: @on-surface;

    selected: @primary-container;
    selected-text: @on-primary-container;

    active: @tertiary-container;
    urgent: @error-container;

    border-color: @outline;

    background-color: @background;
}

/* window */

window {
    height: 600;
    width: 600;

    border: 3;
    border-radius: 10;
    border-color: @border-color;

    background-color: @background;
}

/* layout */

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

/* input */

inputbar {
    color: @foreground;
    padding: 14;

    background-color: @background;
}

prompt {
    text-color: @foreground;
    margin: 0 10 0 0;
}

entry {
    text-color: @foreground;
}

/* message */

message {
    padding: 10;
    background-color: @background-alt;
}

/* results list */

listview {
    padding: 8;

    border-radius: 0 0 10 10;
    border: 2;

    border-color: @background;
    background-color: @background;

    dynamic: false;
}

/* items */

element {
    padding: 5;
    vertical-align: 0.5;

    border-radius: 10;

    background-color: @background-alt;
}

/* alternating rows */

element.alternate.normal {
    background-color: transparent;
}

/* selected */

element.selected.normal {
    background-color: @selected;
}

/* active */

element.normal.active,
element.alternate.active {
    background-color: @active;
}

/* urgent */

element.normal.urgent,
element.alternate.urgent {
    background-color: @urgent;
}

/* text + icons */

element-text,
element-icon {
    size: 40;
    margin: 0 10 0 0;

    vertical-align: 0.5;

    background-color: inherit;
    text-color: @foreground;
}

/* active/urgent text */

element-text.active,
element-text.urgent {
    text-color: @background;
}

/* misc */

textbox {
    text-color: @foreground;
}

error-message {
    border: 20;
}
